    "owasp-agentic-top10",
    "sr-11-7",
    "fedramp",
    "ai-safety",
    "ai-accountability",
    "ai-observability",
    "agent-security",
    "tool-policy-gate",
    "trust-mesh",
    "cryptographic-attestation",
    "policy-as-code",
    "non-repudiation"
  ],
  "author": "TeNova <engineering@tenovaai.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tenova-labs/swt3-ai"
  },
  "homepage": "https://tenova.io",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tenova/swt3-ai": "file:../swt3-ai-ts",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0"
  },
