{
  "name": "@tenova/swt3-mcp",
  "version": "0.6.6",
  "mcpName": "io.tenova/swt3-witness",
  "description": "MCP server for AI compliance audit trail and governance. 37 tools, 1 prompt, 36 frameworks. EU AI Act, NIST AI RMF, GDPR, CMMC, ISO 42001, OWASP Agentic Top 10, SR 11-7. Witness every inference, gate tool calls, enforce clearing levels. Cryptographic attestation with tamper-proof anchor chain.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./middleware": {
      "import": "./dist/middleware.js",
      "types": "./dist/middleware.d.ts"
    }
  },
  "bin": {
    "swt3-mcp": "./dist/bin/swt3-mcp.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/.bin/vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-compliance",
    "ai-audit-trail",
    "ai-governance",
    "compliance-audit",
    "audit-trail",
    "witness",
