{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.tenova/swt3-witness",
  "title": "SWT3 AI Witness",
  "description": "Cryptographic AI governance and audit. 75 tools, 78 frameworks, 47 provider adapters. EU AI Act, NIST AI RMF, CMMC, DORA, G7 AI-SBOM, MCP Top 10, EU Machinery Regulation, ISO 10218. Adapters for OpenAI, Anthropic, Google Vertex, AWS Bedrock, Mistral, Groq, Together, DeepSeek, Azure OpenAI, IBM Granite, NVIDIA, Cohere, LangChain.",
  "websiteUrl": "https://tenova.io",
  "repository": {
    "url": "https://github.com/tenova-labs/swt3-ai",
    "source": "github"
  },
  "version": "0.7.9",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@tenova/swt3-mcp",
      "version": "0.7.9",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "SWT3 API key (starts with axm_). Omit for zero-config demo mode.",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "SWT3_API_KEY"
        },
        {
          "description": "Your tenant identifier",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "SWT3_TENANT_ID"
        },
        {
          "description": "Path to swt3.yaml config file for policy-as-code",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "SWT3_CONFIG_FILE"
        },
        {
          "description": "Data clearing level: 0=analytics, 1=standard, 2=sensitive, 3=classified",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "SWT3_CLEARING_LEVEL"
        },
        {
          "description": "Agent identity for AI-ID.1 witnessing",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "SWT3_AGENT_ID"
        },
        {
          "description": "HMAC-SHA256 signing key for non-repudiation",
          "isRequired": false,
          "format": "string",
          "isSecret": true,
          "name": "SWT3_SIGNING_KEY"
        }
      ]
    }
  ],
