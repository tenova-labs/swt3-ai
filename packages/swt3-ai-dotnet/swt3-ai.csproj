<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>swt3-ai</PackageId>
    <Version>0.7.4</Version>
    <Authors>TeNova Labs</Authors>
    <Company>TeNova Labs</Company>
    <Description>SWT3 AI Witness SDK: cryptographic attestation for AI inference and infrastructure governance. 280 procedures, 9 namespaces, 10 languages, 77 frameworks. EU AI Act, NIST AI RMF, OWASP MCP Top 10, CMMC, SR 11-7, NIS-2, EU Battery Reg, FERC.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/tenova-labs/swt3-ai</RepositoryUrl>
    <PackageProjectUrl>https://sovereign.tenova.io/docs/</PackageProjectUrl>
    <PackageReleaseNotes>https://sovereign.tenova.io/guides/nsa-mcp-security-mapping.html</PackageReleaseNotes>
    <PackageTags>ai;compliance;witness;swt3;eu-ai-act;nist-ai-rmf;ai-governance;ai-audit;ai-accountability;ai-safety;agentic-ai;guardrails;model-governance;cryptographic-attestation;nist-800-53;cmmc;gdpr</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
